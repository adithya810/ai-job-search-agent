# Copy this file to `.env` and fill in your API keys (`.env` is gitignored).

# Autonomous Agent Model Identifier (Hydrogen - Medium Effort)
AGENT_MODEL=hydrogen-medium
AGENT_REASONING_EFFORT=medium

# Exa Neural Search API key (https://dashboard.exa.ai/)
EXA_API_KEY=

# Firecrawl API key (https://www.firecrawl.dev/app/api-keys)
FIRECRAWL_API_KEY=

# Optional: override Firecrawl base URL (e.g. https://api.firecrawl.dev/v2 or self-hosted http://localhost:3002/v1)
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# Gmail SMTP credentials for send_jobs_email.py (create App Password at https://myaccount.google.com/apppasswords)
GMAIL_SENDER=adithyakrishna810@gmail.com
NOTIFY_EMAIL=adithyakrishna810@gmail.com
GMAIL_APP_PASSWORD=
